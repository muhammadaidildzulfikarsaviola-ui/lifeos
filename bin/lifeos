<?php
declare(strict_types=1);
define('BASE_PATH',dirname(__DIR__));
require BASE_PATH.'/app/Core/helpers.php';
require BASE_PATH.'/app/Core/Logger.php';
require BASE_PATH.'/app/Core/Database.php';
require BASE_PATH.'/database/MigrationRunner.php';
$env=BASE_PATH.'/.env';
if(is_readable($env)){foreach(file($env,FILE_IGNORE_NEW_LINES|FILE_SKIP_EMPTY_LINES)?:[] as $line){$line=trim($line);if($line===''||str_starts_with($line,'#')||!str_contains($line,'='))continue;[$k,$v]=explode('=',$line,2);$k=trim($k);$v=trim(trim($v),"'\"");if($k!==''&&getenv($k)===false)putenv($k.'='.$v);}}
use LifeOS\Core\Database;
use LifeOS\Database\MigrationRunner;
$command=$argv[1]??'help';
try{$runner=new MigrationRunner(Database::connection());
if($command==='migrate'){$rows=$runner->migrate();if(!$rows)echo "Database sudah up to date.\n";foreach($rows as $r)echo "[OK] ".$r['name']."\n";}
elseif($command==='migrate:status'){foreach($runner->status() as $r){printf("%-42s %-9s checksum:%s\n",$r['name'],$r['status'],$r['checksum']);if($r['error'])echo "  ".$r['error']."\n";}}
elseif($command==='migrate:retry'&&isset($argv[2])){$runner->retry((string)$argv[2]);echo "Retry selesai. Periksa migrate:status.\n";}
else{echo "LIFEOS CLI\n  php bin/lifeos migrate\n  php bin/lifeos migrate:status\n  php bin/lifeos migrate:retry <migration_name>\n";exit($command==='help'?0:2);}
}catch(Throwable $e){fwrite(STDERR,'[ERROR] '.$e->getMessage().PHP_EOL);exit(1);}
